#!/usr/bin/env bash
# Baja el ambiente de desarrollo: LazyDocker, docker y sesión tmux.

set -uo pipefail

ROOT="${CORE_ROOT:-$HOME/Work/core}"
KERNEL_DIR="$ROOT/kernel"
COMPOSE_FILE="$KERNEL_DIR/docker-compose.yml"
SESSION="core"

RAINBOW=("\033[31m" "\033[33m" "\033[32m" "\033[36m" "\033[34m" "\033[35m")
CYAN="\033[1;38;2;0;230;255m"
PINK="\033[1;38;2;255;60;200m"
GREEN="\033[1;38;2;0;255;120m"
PURPLE="\033[1;38;2;160;100;255m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
GRAY="\033[90m"
C_RESET="\033[0m"

BAR_W=24

rainbow_text() {
  local text="$1" i=0 j len=${#1}
  for ((j=0; j<len; j++)); do
    local char="${text:$j:1}"
    printf "\033[1m${RAINBOW[$((i % 6))]}%s\033[0m" "$char"
    [[ "$char" != " " ]] && ((i++))
  done
}

# Ejecuta "$@" en segundo plano mostrando spinner y barra.
# Código de salida 0 = ✔, cualquier otro = ✘.
step() {
  local label="$1"; shift
  local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) f=0 fill=0 bar="" j
  local log; log="$(mktemp)"

  "$@" >"$log" 2>&1 &
  local pid=$!

  while kill -0 "$pid" 2>/dev/null; do
    (( fill < BAR_W - 1 )) && (( fill++ ))
    bar=""
    for ((j=0; j<BAR_W; j++)); do
      [ $j -lt $fill ] && bar+="█" || bar+="░"
    done
    printf "    ${CYAN}%s${C_RESET}  %-17s  ${PURPLE}[%s]${C_RESET} %3d%%\r" \
      "${frames[$((f % 10))]}" "$label" "$bar" "$((fill * 100 / BAR_W))"
    ((f++))
    sleep 0.08
  done
  wait "$pid"
  local rc=$?

  bar=$(printf '█%.0s' $(seq 1 $BAR_W))
  if [ $rc -eq 0 ]; then
    printf "    ${PINK}✔${C_RESET}  ${GREEN}%-17s  [%s] 100%%${C_RESET}\n" "$label" "$bar"
  else
    printf "    ${RED}✘${C_RESET}  ${RED}%-17s  falló${C_RESET}%*s\n" "$label" 30 ""
    tail -n 5 "$log" | sed 's/^/       /' | while IFS= read -r l; do printf "${GRAY}%s${C_RESET}\n" "$l"; done
  fi
  rm -f "$log"
  return $rc
}

lazydocker_step() {
  pkill -x lazydocker 2>/dev/null || true
  sleep 1
}

docker_step() {
  docker compose -f "$COMPOSE_FILE" down
}

# ── HEADER ────────────────────────────────────────────────────────────────────

printf '\n'
printf "  \033[31m┌──────────────────────────────────┐${C_RESET}\n"
printf "  \033[31m│${C_RESET}  $(rainbow_text "BAJANDO AMBIENTE DESARROLLO")    \033[31m│${C_RESET}\n"
printf "  \033[31m└──────────────────────────────────┘${C_RESET}\n"
printf '\n'

if [ -t 0 ]; then
  printf "  ${YELLOW}⚠  ¿Ya le pediste a Claude que guarde el resumen de sesión?${C_RESET}\n"
  printf "  ${GRAY}   (si no, cancelá con Ctrl+C y pedile que guarde el resumen)${C_RESET}\n\n"
  printf "  Continuar de todas formas? ${GRAY}[Enter / Ctrl+C]${C_RESET} "
  read -r
fi

tput civis 2>/dev/null
trap 'tput cnorm 2>/dev/null' EXIT
trap 'tput cnorm 2>/dev/null; exit 1' INT TERM

# ── PASOS ─────────────────────────────────────────────────────────────────────

step "LazyDocker" lazydocker_step
step "Docker" docker_step

# ── CIERRE ────────────────────────────────────────────────────────────────────

printf "\n  ${GREEN}✔ Ambiente detenido.${C_RESET}\n\n"
tput cnorm 2>/dev/null

if [ -t 0 ] && tmux has-session -t "$SESSION" 2>/dev/null; then
  printf "  ${CYAN}¿Cerrar tmux? [S/n]${C_RESET}  "
  read -r _resp
  if [[ "$_resp" =~ ^[nN]$ ]]; then
    printf "\n  ${PURPLE}tmux omitido.${C_RESET}\n\n"
    exit 0
  fi
  tmux kill-session -t "$SESSION"
fi
