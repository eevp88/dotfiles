#!/usr/bin/env bash
# Levanta el ambiente de desarrollo: git, docker, VS Code, navegador y sesión tmux.

set -uo pipefail

ROOT="${CORE_ROOT:-$HOME/Work/core}"
KERNEL_DIR="$ROOT/kernel"
MODULES_DIR="$ROOT/modules"
COMPOSE_FILE="$KERNEL_DIR/docker-compose.yml"
APP_URL="https://localhost/core"
SESSION="core"

RAINBOW=("\033[31m" "\033[33m" "\033[32m" "\033[36m" "\033[34m" "\033[35m")
CYAN="\033[1;38;2;0;230;255m"
PINK="\033[1;38;2;255;60;200m"
GREEN="\033[1;38;2;0;255;120m"
PURPLE="\033[1;38;2;160;100;255m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
GRAY="\033[90m"
C_RESET="\033[0m"

BAR_W=24
STEP_LOG=""
STEP_PID=""

rainbow_text() {
  local text="$1" i=0 j len=${#1}
  for ((j=0; j<len; j++)); do
    local char="${text:$j:1}"
    printf "\033[1m${RAINBOW[$((i % 6))]}%s\033[0m" "$char"
    [[ "$char" != " " ]] && ((i++))
  done
}

# Ejecuta "$@" en segundo plano mostrando spinner y barra.
# Código de salida 0 = ✔, 2 = ⚠ (omitido, no aborta), otro = ✘.
step() {
  local label="$1"; shift
  local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) f=0 fill=0 bar="" j
  local log; log="$(mktemp)"
  STEP_LOG="$log"

  "$@" >"$log" 2>&1 &
  local pid=$!
  STEP_PID=$pid

  while kill -0 "$pid" 2>/dev/null; do
    (( fill < BAR_W - 1 )) && (( fill++ ))
    bar=""
    for ((j=0; j<BAR_W; j++)); do
      [ $j -lt $fill ] && bar+="█" || bar+="░"
    done
    printf "    ${CYAN}%s${C_RESET}  %-17s  ${PURPLE}[%s]${C_RESET} %3d%%\r" \
      "${frames[$((f % 10))]}" "$label" "$bar" "$((fill * 100 / BAR_W))"
    ((f++))
    sleep 0.08
  done
  wait "$pid"
  local rc=$?

  bar=$(printf '█%.0s' $(seq 1 $BAR_W))
  case $rc in
    0)
      printf "    ${PINK}✔${C_RESET}  ${GREEN}%-17s  [%s] 100%%${C_RESET}\n" "$label" "$bar"
      ;;
    2)
      printf "    ${YELLOW}⚠${C_RESET}  ${YELLOW}%-17s  omitido${C_RESET}\033[K\n" "$label"
      tail -n 2 "$log" | sed 's/^/       /' | while IFS= read -r l; do printf "${GRAY}%s${C_RESET}\n" "$l"; done
      ;;
    *)
      printf "    ${RED}✘${C_RESET}  ${RED}%-17s  falló${C_RESET}\033[K\n" "$label"
      tail -n 5 "$log" | sed 's/^/       /' | while IFS= read -r l; do printf "${GRAY}%s${C_RESET}\n" "$l"; done
      ;;
  esac
  rm -f "$log"
  STEP_LOG=""; STEP_PID=""
  return $rc
}

git_step() {
  timeout 20 git -C "$KERNEL_DIR" pull --ff-only --autostash -q
  local rc=$?
  # Solo el timeout (sin red) es "omitido"; cualquier otro error es una falla real.
  [ "$rc" -eq 124 ] && return 2
  return "$rc"
}

# Cada carpeta de modules/ es un repo independiente: pull por separado, sin
# --autostash para no tocar trabajo en curso; un fallo no frena a los demás.
git_modulos_step() {
  local dir name out rc fallos=0 timeouts=0
  for dir in "$MODULES_DIR"/*/; do
    [ -e "$dir/.git" ] || continue
    name="$(basename "$dir")"
    if ! git -C "$dir" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
      echo "$name: sin upstream, omitido"
      continue
    fi
    out="$(timeout 20 git -C "$dir" pull --ff-only -q 2>&1)"
    rc=$?
    case $rc in
      0) ;;
      124) echo "$name: timeout"; ((timeouts++)) ;;
      *) echo "$name: ${out%%$'\n'*}"; ((fallos++)) ;;
    esac
  done
  (( fallos > 0 )) && return 1
  (( timeouts > 0 )) && return 2
  return 0
}

docker_step() {
  docker compose -f "$COMPOSE_FILE" up -d --force-recreate --remove-orphans
}

vscode_step() {
  setsid code "$MODULES_DIR" >/dev/null 2>&1 &
  sleep 1
}

browser_step() {
  timeout 30 bash -c "until curl -skfL -o /dev/null '$APP_URL/'; do sleep 0.5; done" || return 2
  setsid xdg-open "$APP_URL" >/dev/null 2>&1 &
}

abrir_tmux() {
  # Preferir tmux-core (dotfiles personales); si no existe, usar el layout propio.
  if command -v tmux-core >/dev/null 2>&1; then
    exec tmux-core "$ROOT"
  fi
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux new-session -d -s "$SESSION" -n claude -c "$ROOT" "bash -lc 'claude; exec bash'"
    tmux new-window -t "$SESSION" -n workspace -c "$ROOT" "lazydocker"
    tmux split-window -h -t "$SESSION:workspace" -c "$ROOT"
    tmux new-window -t "$SESSION" -n Tokens -c "$ROOT" "bash -lc 'npx codeburn; exec bash'"
    tmux select-window -t "$SESSION:claude"
  fi
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$SESSION"
  else
    exec tmux attach -t "$SESSION"
  fi
}

# ── HEADER ────────────────────────────────────────────────────────────────────

printf '\n'
printf "  \033[32m┌──────────────────────────────────┐${C_RESET}\n"
printf "  \033[32m│${C_RESET}  $(rainbow_text "LEVANTANDO AMBIENTE DESARROLLO")  \033[32m│${C_RESET}\n"
printf "  \033[32m└──────────────────────────────────┘${C_RESET}\n"
printf '\n'

tput civis 2>/dev/null
# Al salir (normal o por Ctrl-C) restaura el cursor, detiene el paso en curso y borra su log.
limpiar() {
  if [ -n "$STEP_PID" ]; then
    pkill -P "$STEP_PID" 2>/dev/null
    kill "$STEP_PID" 2>/dev/null
  fi
  [ -n "$STEP_LOG" ] && rm -f "$STEP_LOG"
  tput cnorm 2>/dev/null
}
trap limpiar EXIT
trap 'exit 1' INT TERM

# ── PASOS ─────────────────────────────────────────────────────────────────────

step "Git" git_step
step "Git módulos" git_modulos_step

if ! step "Docker" docker_step; then
  printf "\n  ${RED}falló docker, abortando.${C_RESET}\n\n" >&2
  exit 1
fi

step "VS Code" vscode_step
step "Navegador" browser_step

# ── CIERRE ────────────────────────────────────────────────────────────────────

printf "\n"
printf "  ${GRAY}  App  →${C_RESET}  ${CYAN}%s${C_RESET}\n" "$APP_URL"
printf "\n  ${GREEN}✔ Ambiente listo.${C_RESET}\n\n"
tput cnorm 2>/dev/null

if [ -t 0 ]; then
  printf "  ${CYAN}¿Abrir tmux? [S/n]${C_RESET}  "
  read -r _resp
  if [[ "$_resp" =~ ^[nN]$ ]]; then
    printf "\n  ${PURPLE}tmux omitido.${C_RESET}\n\n"
    exit 0
  fi
  abrir_tmux
fi
