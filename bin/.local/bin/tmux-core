#!/usr/bin/env bash
# Open the "core" tmux session: claude, workspace (lazydocker + shell) and Tokens.
# Usage: tmux-core [project-dir]
# Without an argument it asks for the directory (default: ~/Work/core).

set -uo pipefail

DIR="${1:-}"
if [ -z "$DIR" ]; then
  DIR="$HOME/Work/core"
  if [ -t 0 ]; then
    read -r -e -i "$DIR" -p "Project directory: " DIR
  fi
fi
DIR="${DIR/#\~/$HOME}"

ROOT="$(cd -- "$DIR" 2>/dev/null && pwd)" || {
  echo "tmux-core: directory not found: $DIR" >&2
  exit 1
}
SESSION="core"

if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  tmux new-session -d -s "$SESSION" -n claude -c "$ROOT" "bash -lc 'claude; exec bash'"
  tmux new-window -t "$SESSION" -n workspace -c "$ROOT" "lazydocker"
  tmux split-window -h -t "$SESSION:workspace" -c "$ROOT"
  tmux new-window -t "$SESSION" -n Tokens -c "$ROOT" "bash -lc 'npx codeburn; exec bash'"
  tmux select-window -t "$SESSION:claude"
fi

if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "$SESSION"
else
  exec tmux attach -t "$SESSION"
fi
